# Lấy từ @BotFather trên Telegram (xem INSTALL_TELEGRAM.md)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Chat ID của bạn hoặc nhóm (lấy qua @userinfobot hoặc getUpdates API)
TELEGRAM_CHAT_ID=your_chat_id_here

# ---------------------------------------------------------------------------
# Cách dùng
#   1. Copy tệp này thành .env rồi điền giá trị thật (.env đã bị gitignore).
#   2. Chạy dev:      python main.py --cli --now      (đọc trực tiếp .env)
#   3. Build release: python scripts/embed_credentials.py
#      -> sinh utils/credentials.py để PyInstaller nhúng vào .exe,
#         khách dùng không cần .env riêng. Tệp sinh ra cũng bị gitignore.
#
# LƯU Ý BẢO MẬT: giá trị nhúng trong .exe chỉ bị làm khó đọc, KHÔNG phải bí mật
# — ai có file .exe đều trích được bằng `strings`. Hãy khoá bot vào đúng channel
# của nó, và /revoke trong @BotFather nếu một bản build bị lọt ra ngoài.
# ---------------------------------------------------------------------------
