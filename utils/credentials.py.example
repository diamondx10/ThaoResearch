"""Embedded Telegram credentials — TEMPLATE (safe to commit).

This file is a template only. The real module lives at
``utils/credentials.py``, which is **gitignored** because it contains the
live bot token.

How it works
------------
``main.load_env()`` prefers this module when it holds real values, so the
PyInstaller build can bake the credentials into the .exe and end users do
not need their own ``.env``. When the module is missing or still holds the
placeholders below, ``load_env()`` falls back to the ``.env`` file — which
is the normal path during development.

Setup
-----
1. Copy ``.env.example`` to ``.env`` and fill in your own values::

       TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
       TELEGRAM_CHAT_ID=-1001234567890

2. Generate the embedded module from ``.env``::

       python scripts/embed_credentials.py

   That writes ``utils/credentials.py``. Never commit it, and never paste
   real values into this ``.example`` file.
"""

TELEGRAM_BOT_TOKEN = "YOUR_BOT_TOKEN_HERE"
TELEGRAM_CHAT_ID = "YOUR_CHAT_ID_HERE"

_PLACEHOLDERS = {"", "YOUR_BOT_TOKEN_HERE", "YOUR_CHAT_ID_HERE"}


def has_embedded_credentials() -> bool:
    """Return True only when both values have been replaced with real ones."""
    return (
        TELEGRAM_BOT_TOKEN not in _PLACEHOLDERS
        and TELEGRAM_CHAT_ID not in _PLACEHOLDERS
    )
